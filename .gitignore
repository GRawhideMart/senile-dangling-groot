*.exr

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
env/
venv/
.venv/

# Blender backup and crash files
*.blend1
*.blend2
*.blend@
*.crash.txt

